# ============================================================
# Tuk Or Walk — Cloudflare Pages _headers
# ============================================================

# ---------- Security headers for all pages ----------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  
  # Updated CSP to allow images, fonts, and scripts from the sources we use
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://pub-073bb9ec0405497288c023970f27deee.r2.dev https://myimgs.org https://tile.openstreetmap.org https://www.gstatic.com https://translate.google.com https://translate.googleapis.com https://www.google.com https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://translate.google.com https://translate.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://translate.googleapis.com https://www.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; frame-src https://www.google.com; connect-src 'self' https://translate.googleapis.com https://translate.google.com; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'

# ---------- Robots & sitemap (correct content types) ----------
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# ---------- HTML pages: short cache, must revalidate ----------
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Shared CSS/JS (same file names are reused, so revalidate daily) ----------
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
